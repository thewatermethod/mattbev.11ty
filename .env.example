# Local builds only: Netlify uses committed posts and needs no Tumblr/R2 credentials.
# Existing Tumblr API key and blog hostname, e.g. your-blog.tumblr.com.
# Archives all published posts. Private posts/drafts require a separate OAuth export.
TUMBLR_API_KEY=
TUMBLR_BLOG_NAME=

# Cloudflare R2 S3 credentials with Object Read & Write access to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public HTTPS bucket URL (custom domain or r2.dev URL), without a trailing slash.
# The bucket stores both media and raw published-post archive snapshots.
R2_PUBLIC_URL=
