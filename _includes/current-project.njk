{% set currentProjects = collections.currentProjects %}
{% if currentProjects.length > 0 %}
<section class="panel sidebar--current current-project" aria-labelledby="current-projects-heading">
    <h2 id="current-projects-heading">Current Projects</h2>
    <ul class="current-project-list">
    {% for project in currentProjects | reverse %}
        <li>
            {% if project.data.link %}
                <a href="{{ project.data.link }}">
            {% endif %}
            <strong>{{ project.data.title }}</strong>
            {% if project.data.link %}
                </a>
            {% endif %}
            {% if project.data.status %}
                <br /><span class="sidebar--current__status">{{ project.data.status }}</span>
            {% endif %}
        </li>
    {% endfor %}
    </ul>
</section>
{% endif %}
