<!doctype html>
<html lang="{{ metadata.language }}">
  {% include "htmlhead.njk" %}
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header {% if templateClass %}header-{{ templateClass }}{% endif %}">
      {% include "navigation.njk" %}
    </header>

    <main id="main" tabindex="-1"{% if templateClass %} class="main-{{ templateClass }}"{% endif %}>
      <div class="window">
        <div class="window__titlebar" aria-hidden="true"></div>
        <section class="window__body content-section">
          {{ content | safe }}
        </section>
      </div>
    </main>

    {% include "footer.njk" %}

    <!-- Current page: {{ page.url | url }} -->
    <script type="module">
      const blocks = document.querySelectorAll("pre > code");
      // Code blocks can scroll sideways; keep them reachable by keyboard.
      blocks.forEach((code) => code.parentElement.setAttribute("tabindex", "0"));
      // microlighter needs the CSS Custom Highlight API; without it code stays plain text.
      if (blocks.length && "highlights" in CSS) {
        import("{{ '/assets/microlighter/microlighter.min.js' | url }}");
      }
    </script>
  </body>
</html>
