---
layout: layouts/base.njk
templateClass: tmpl-post
---
<h1 class="page-title">{{ title }}</h1>

<div class="post-meta">
  <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
  {%- for tag in tags | filterTagList %}
  {%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
  <a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>
  {%- endfor %}
</div>

{{ content | safe }}

{%- if collections.posts %}
{%- set nextPost = collections.posts | getNextCollectionItem(page) %}
{%- set previousPost = collections.posts | getPreviousCollectionItem(page) %}
{%- if nextPost or previousPost %}
<nav aria-label="More posts">
  <ul class="post-nav">
    {%- if nextPost %}<li><span class="post-nav__label">Next:</span> <a href="{{ nextPost.url | url }}">{{ nextPost.data.title }}</a></li>{% endif %}
    {%- if previousPost %}<li><span class="post-nav__label">Previous:</span> <a href="{{ previousPost.url | url }}">{{ previousPost.data.title }}</a></li>{% endif %}
  </ul>
</nav>
{%- endif %}
{%- endif %}
