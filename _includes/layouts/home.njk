---
templateClass: tmpl-home
---
<!doctype html>
<html lang="{{ metadata.language }}">
    {%- set extraStylesheets = ['/css/home.css'] %}
    {% include "htmlhead.njk" %}
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header {% if templateClass %}header-{{ templateClass }}{% endif %}">
        {% include "navigation.njk" %}
    </header>

    <div class="hero">
        <div class="panel hero__id">
            <h1 class="home--title">{{ metadata.title }}</h1>
            <p class="home--subtitle">{{ metadata.subtitle }}</p>
        </div>
        <div class="panel hero__contact">
            <ul class="who">
                <li><a href="mailto:matt@mattbev.com">matt@mattbev.com</a></li>
                <li>
                    <a href="https://github.com/thewatermethod">Github</a> and
                    <a href="https://gitlab.com/thewatermethod">Gitlab</a>.
                </li>
                <li>
                    <a href="https://www.drivethrurpg.com/en/publisher/26719/twilit-grotto">DriveThruRPG</a> and
                    <a href="https://twilitgrotto.itch.io/">Itch.io</a>.
                </li>
            </ul>
        </div>
    </div>

    <main id="main" tabindex="-1"{% if templateClass %} class="main-{{ templateClass }}"{% endif %}>
        <div class="window">
            <div class="window__titlebar" aria-hidden="true">

            </div>
            <div class="window__body content-section">
                {{ content | safe }}
            </div>
        </div>
        <div class="sidebar">
            {% include "currently-reading.njk" %}
            {% include "current-project.njk" %}
        </div>
    </main>

    {% include "footer.njk" %}

    <!-- Current page: {{ page.url | url }} -->
  </body>
</html>
