  <li class="postlist-item postlist-item-tumblr{% if post.url == url %} postlist-item-active{% endif %}">
    {% if post.data.tags | hasTag("tumblr-photo") or post.data.tags | hasTag("tumblr-text") %}
      <div class="tumblr-body">{{ post.templateContent | tumblrBody | safe }}</div>
    {% else %}
      <a href="{{ post.url | url }}" class="postlist-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
    {% endif %}
    <a href="{{ post.url | url }}" class="postlist-date"><time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></a>

    <a href="{{ post.data.url }}" class="post-tag">originally on tumblr</a>
    {% for tag in post.data.tags | filterTagList %}{% if not tag.startsWith("tumblr") %}
      {% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
      <a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>
    {% endif %}{% endfor %}

  </li>
